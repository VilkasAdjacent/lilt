# ---- Personal voice data: never commit ----
# Audio of any kind, anywhere in the repo
*.wav
*.m4a
*.mp3
*.ogg
*.opus
*.flac
*.aac
*.webm
# Recordings (baseline, reference clips, check-ins); only the script is tracked
/recordings/**
!/recordings/
!/recordings/RECORDING_SCRIPT.md
# Measurements derived from my recordings (regenerate with analysis/run.py)
/analysis/cache/
/analysis/results/
/bench/data/truth.json
/bench/data/tilt_ref.json
/bench/results/tracks/

# ---- Regenerable / tooling ----
/analysis/.venv/
__pycache__/
*.pyc
node_modules/
# Synthetic bench vowels (regenerate with bench/praat_truth.py)
/bench/data/synth/

# ---- Agent scratch ----
/.agent_scratch/

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/settings.json
*.log

# Research notes contain personal measurements and intake context: local only
/research/
